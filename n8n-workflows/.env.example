# ========================================
# CREDENCIAIS MARKETING CLOUD
# ========================================
#
# Obtenha em: Marketing Cloud → Setup → Apps → Installed Packages
#

# Client ID (exemplo: abc123xyz456)
MC_CLIENT_ID=SEU_CLIENT_ID_AQUI

# Client Secret (mantenha em segredo!)
MC_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI

# Subdomain (apenas a parte mcXXXXXXXXX)
# Exemplo: se a URL é https://mc123456789.auth.marketingcloudapis.com
# Então o subdomain é: mc123456789
MC_SUBDOMAIN=SEU_SUBDOMAIN_AQUI

# Account ID / MID (Member ID)
# Geralmente é um número de 6-10 dígitos
MC_ACCOUNT_ID=SEU_ACCOUNT_ID_AQUI

# ========================================
# JORNADA PARA ATIVAR
# ========================================

# Journey ID (UUID da jornada)
# Exemplo: 12345678-1234-1234-1234-123456789abc
# Encontre em: Journey Builder → Abrir Jornada → Ver na URL
JOURNEY_ID=ID_DA_JORNADA_AQUI

# ========================================
# NOTAS
# ========================================
#
# - NÃO commite este arquivo com valores reais
# - No N8N, configure direto no node "Configurações"
# - Este arquivo é apenas referência
#
