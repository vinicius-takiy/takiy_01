# === Anthropic ===
ANTHROPIC_API_KEY=your_anthropic_api_key

# === Meta Ads ===
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_long_lived_access_token
META_AD_ACCOUNT_ID=act_123456789          # formato: act_XXXXXXXXX

# === Google Ads ===
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890   # MCC ID (sem hifens)
GOOGLE_ADS_CUSTOMER_ID=9876543210         # Conta anunciante (sem hifens)

# === TikTok Ads ===
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_SECRET=your_tiktok_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_ADVERTISER_ID=your_tiktok_advertiser_id

# === GA4 ===
GA4_PROPERTY_ID=123456789                 # só os números, sem "properties/"
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password           # Gmail: use App Password
EMAIL_FROM=you@gmail.com
EMAIL_TO=recipient@example.com,another@example.com

# === Alertas - Limites de anomalia ===
ANOMALY_THRESHOLD_PCT=20                  # % de queda para acionar alerta
DAILY_BUDGET_ALERT_PCT=90                # % do budget consumido para alertar
